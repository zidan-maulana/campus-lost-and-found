APP_NAME="UMBFind"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database — Supabase (PostgreSQL)
# Gunakan tab "Session pooler" (port 5432) dari Dashboard > Connect.
# Catatan: bila password mengandung karakter khusus seperti '#', wajib
# dibungkus tanda kutip agar tidak dianggap komentar oleh parser .env.
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=""
DB_SSLMODE=require

# ---------------------------------------------------------------------------
# Supabase Storage (S3-compatible) — foto laporan & avatar
# Dashboard > Storage > Settings > S3 Access Keys  ->  "Create keys"
# Bucket harus dibuat & diset PUBLIC (mis. nama: findumb-media)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_BUCKET=findumb-media
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_S3_REGION=ap-southeast-2

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@findumb.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Aturan bisnis yang masih menunggu keputusan (lihat docs/DECISIONS_LOG.md)
# ---------------------------------------------------------------------------
# DEC-016 — domain email kampus yang diizinkan (pisahkan dengan koma).
CAMPUS_EMAIL_DOMAINS=mercubuana.ac.id,student.mercubuana.ac.id
# DEC-021 — validasi foto laporan (usulan: 1 file, 2 MB, JPEG/PNG/WebP).
REPORT_PHOTO_MAX_KB=2048
REPORT_PHOTO_MIMES=jpg,jpeg,png,webp
# DEC-024 — batas waktu klaim tanpa respons (jam) dan pengingat.
CLAIM_EXPIRY_HOURS=120
CLAIM_REMINDER_HOURS=72
# BR-09 — retensi pesan chat setelah serah terima (hari).
CHAT_RETENTION_DAYS=30
# Polling chat di sisi klien (detik).
CHAT_POLL_SECONDS=5